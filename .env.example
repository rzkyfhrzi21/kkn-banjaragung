# Contoh .env untuk deployment
# Ganti nilai sesuai kebutuhan sebelum deployment
PORT=3000
PUBLIC_URL=http://example.com
# Untuk kemudahan setup lokal bisa pakai ADMIN_PASSWORD (plain).
# Untuk production, lebih aman gunakan ADMIN_PASSWORD_HASH (format: salt:hexhash)
ADMIN_PASSWORD=change_me
# ADMIN_PASSWORD_HASH=d89b69b7348aa9e97b4741286a06df31:129f5b4... (contoh format)
# Gunakan 1 untuk mencoba sqlite (opsional)
USE_SQLITE=0
# Jika menggunakan layanan object storage, set PUBLIC_URL ke lokasi CDN/S3
# Untuk pembentukan VAPID (push), email admin untuk VAPID details
VAPID_CONTACT=mailto:admin@example.com
